node_modules/

# Scratch scripts written by the exporters on each run
tools/_*.js
_phase.js

# Regenerable intermediates. Everything here is produced from the Pixso file by
# tools/px-*.mjs in a few minutes; none of it is source.
out/*.json
out/chunks/
out/hdr/
out/screen/
out/full-section.js
out/sect*.js
out/import-payload*.js
out/build4.js

# Payload carriers and extracted design images (regenerable, large)
out/section-v*.png
out/img-*.png
out/img-*.jpg
out/probe*.png

# Intermediate renders and crops from earlier fix rounds
out/section-figma-v[1-9].png
out/section-figma.png
out/rebuilt-figma.png
out/screen2-figma.png
out/crop-*.png
out/icons-*.png
out/nav-*.png
out/v7-*.png
out/v8-*.png
out/hs[0-9A-Z]-*.png
out/dd-pixso.png
out/dd-figma*.png
out/dd-sbs.png
out/dd.svg
out/icon-figma.png
out/icon-figma-z.png
out/section.png
out/section[0-9].png
out/source-pixso.png
out/t7out.json

# Environment: Product OS library copied in by po.ps1. Not project source.
.claude/
t-inflate.mjs

# Extracted image bytes: regenerable by px-images.mjs
out/*-img/
out/img/
out/run/

# Per-section extraction directories: regenerable from Pixso
out/s-*/

# Per-file working directories: everything here is regenerable from the source file
# by tools/migrate-file.mjs, and a single run of a large file is hundreds of megabytes.
out/

# Scratch probes written while chasing one specific defect. Kept out of the way; the
# tools worth keeping are the ones named in the README.
tools/probe-*.mjs
tools/align*.mjs
tools/gridcmp.mjs
tools/ping*.mjs
tools/size-probe.mjs
tools/inkbox.mjs
tools/lightbox.mjs
tools/rowprof.mjs
tools/count-pages.mjs
tools/t-noimg.mjs
tools/_*.js
